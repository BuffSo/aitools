# 데모·문의 폼 메일 전송 (Resend) — 로컬은 .env.local 에, 배포는 Vercel 환경변수에 설정
# https://resend.com/api-keys
RESEND_API_KEY=

# 문의 수신 메일 (미설정 시 기본값 aitoolz@kakao.com)
INQUIRY_TO_EMAIL=aitoolz@kakao.com

# 발신 표기. 도메인(aitoolz.kr) 인증 전에는 onboarding@resend.dev 사용.
# 도메인 인증 후 예) "AI TOOLS <noreply@aitoolz.kr>"
INQUIRY_FROM_EMAIL=AI TOOLS <onboarding@resend.dev>
